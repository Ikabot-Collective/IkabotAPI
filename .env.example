# The Webhook URL of a discord channel for logs (optional)
LOGS_WEBHOOK_URL=

# Hide IP addresses in the logs sent to Discord (default: true). Set to "false" to show them.
# Console and server logs always keep the full message.
LOGS_WEBHOOK_HIDE_IPS=true

# Set to "true" to run Playwright in headless mode (default: false, uses Xvfb in Docker)
PLAYWRIGHT_HEADLESS=false

# Active token generation timeout in seconds, excluding queue wait and cleanup (default: 120)
TOKEN_GENERATION_TIMEOUT_SECONDS=120
