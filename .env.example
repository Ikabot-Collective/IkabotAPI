# The Webhook URL of a discord channel for logs (optional)
LOGS_WEBHOOK_URL=

# Set to "true" to run Playwright in headless mode (default: false, uses Xvfb in Docker)
PLAYWRIGHT_HEADLESS=false

# Relaunch the shared Chromium after this many tokens (default: 100)
BROWSER_RECYCLE_AFTER=100

# Seconds a single token may run before it is failed and the worker restarted (default: 120)
TOKEN_JOB_TIMEOUT=120
